{
    "ApiBaseUrl": "https://localhost:7280",
    "InputLibs": [
        {
            "id": "cpp",
            "label": "C++",
            "monacoEditorId": "cpp",
            "defaultExample": "bool nieco() { \n    int intDecl; \n    auto lam = [&intDecl](int a) -> bool { \n        a = a + 3; \n        intDecl = 0; \n        return true; \n    }; \n    return lam(intDecl); \n}"
        },
        {
            "id": "csharp",
            "label": "C#",
            "monacoEditorId": "csharp",
            "defaultExample": "using System;\n\nnamespace HelloWorld {\n    class Program {\n        static void Main(string[] args) {\n            Console.WriteLine(\"Hello World from C#\");\n        }\n    }\n}"
        },
        {
            "id": "java",
            "label": "Java",
            "monacoEditorId": "java",
            "defaultExample": "public interface Animal { \n    String makeSound(); \n    String getName(); \n}"
        }
    ],
    "OutputLibs": [
        {
            "id": "text-pseudocode",
            "label": "Text Pseudocode"
        },
        {
            "id": "text-javacode",
            "label": "Text Java Code"
        },
        {
            "id": "uml",
            "label": "UML",
            "config": [
                {
                    "id": "typeConvention",
                    "label": "Type Convention",
                    "type": "select",
                    "cols": 12,
                    "defaultValue": "TYPE_AFTER_IDENTIFIER",
                    "options": [
                        { "value": "TYPE_AFTER_IDENTIFIER", "label": "Type : Identifier" },
                        { "value": "TYPE_BEFORE_IDENTIFIER", "label": "Identifier : Types" }
                    ]
                },
                {
                    "id": "innerView",
                    "label": "Inner View",
                    "type": "boolean",
                    "cols": 4,
                    "defaultValue": true,
                    "description": "Show inner class/struct members"
                },
                {
                    "id": "drawAccessModIcons",
                    "label": "Draw Access Modifiers",
                    "type": "boolean",
                    "cols": 4,
                    "defaultValue": true,
                    "description": "Show +, -, #, ~ icons for access levels"
                },
                {
                    "id": "handleNamespaces",
                    "label": "Handle Namespaces",
                    "type": "boolean",
                    "cols": 4,
                    "defaultValue": true,
                    "description": "Include namespace information"
                },
                {
                    "id": "diagramBG",
                    "label": "Diagram Background Color",
                    "type": "color",
                    "cols": 4,
                    "defaultValue": "#FFFFFF"
                },
                {
                    "id": "elementBG",
                    "label": "Element Background Color",
                    "type": "color",
                    "cols": 4,
                    "defaultValue": "#FFDDDD"
                },
                {
                    "id": "fontColor",
                    "label": "Font Color",
                    "type": "color",
                    "cols": 4,
                    "defaultValue": "#000000"
                }
            ]
        }
